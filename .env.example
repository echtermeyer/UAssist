# ── GitHub (required for docker-compose image references) ─────────────────────
GITHUB_REPOSITORY=your-org/uassist

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_ROOT_PASSWORD=change-me-strong-password
MONGO_API_PASSWORD=change-me-api-password

# Must match MONGO_API_PASSWORD above
MONGO_URL=mongodb://uassist_api:change-me-api-password@mongodb:27017/?authSource=admin
# Must match MONGO_ROOT_PASSWORD above
MONGO_ADMIN_URL=mongodb://mongoadmin:change-me-strong-password@mongodb:27017/?authSource=admin

# ── App secrets ───────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-64-hex-chars
ADMIN_PASS=change-me-admin-password

# ── AWS KMS (envelope encryption for per-user data keys) ──────────────────────
AWS_ACCESS_KEY_ID=your-iam-access-key-id
AWS_SECRET_ACCESS_KEY=your-iam-secret-access-key
AWS_REGION=eu-central-1
AWS_KMS_KEY_ID=arn:aws:kms:eu-central-1:your-account-id:key/your-key-id

# ── Frontend ──────────────────────────────────────────────────────────────────
# Used at build time — must be the public URL users access the API from
NEXT_PUBLIC_API_URL=http://your-server-ip:3000
CORS_ORIGIN=http://your-server-ip:3001

# ── Cookies ───────────────────────────────────────────────────────────────────
# Set to true when serving over HTTPS
COOKIE_SECURE=false

# ── Tenant worker image ───────────────────────────────────────────────────────
TENANT_WORKER_IMAGE=ghcr.io/your-org/uassist/tenant-worker:latest
