# ── GitHub (required for docker-compose image references) ─────────────────────
GITHUB_REPOSITORY=your-org/uassist

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_ROOT_PASSWORD=change-me-strong-password
MONGO_API_PASSWORD=change-me-api-password

# Must match MONGO_API_PASSWORD above
MONGO_URL=mongodb://uassist_api:change-me-api-password@mongodb:27017/?authSource=admin
# Must match MONGO_ROOT_PASSWORD above
MONGO_ADMIN_URL=mongodb://mongoadmin:change-me-strong-password@mongodb:27017/?authSource=admin

# ── App secrets ───────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-64-hex-chars
ADMIN_PASS=change-me-admin-password

# ── KMS (envelope encryption for per-user data keys) ──────────────────────────
# GCP Cloud KMS: set KMS_KEY_NAME (takes precedence). On GCP auth comes from
# the attached service account; elsewhere set GOOGLE_APPLICATION_CREDENTIALS.
KMS_KEY_NAME=projects/your-project/locations/europe-west3/keyRings/uassist/cryptoKeys/user-data-keys

# Legacy AWS KMS (used only when KMS_KEY_NAME is unset; remove after migration)
#AWS_ACCESS_KEY_ID=your-iam-access-key-id
#AWS_SECRET_ACCESS_KEY=your-iam-secret-access-key
#AWS_REGION=eu-central-1
#AWS_KMS_KEY_ID=arn:aws:kms:eu-central-1:your-account-id:key/your-key-id

# ── Worker agent (tenant container management) ────────────────────────────────
# URL the API uses to reach the worker-agent
AGENT_URL=http://worker-agent:8080
# true for single-host docker-compose; false on GCP (OIDC ID-token auth)
AGENT_AUTH_DISABLED=true
# Mongo URL injected into tenant-worker containers (usually same as MONGO_URL)
WORKER_MONGO_URL=mongodb://uassist_api:change-me-api-password@mongodb:27017/?authSource=admin
# GCP only: service account emails allowed to call the agent (comma-separated)
#ALLOWED_SA_EMAILS=sa-api-run@your-project.iam.gserviceaccount.com
# GCP only: audience the agent expects in ID tokens (the AGENT_URL the API uses)
#AGENT_AUDIENCE=http://10.10.0.10:8080

# ── Frontend ──────────────────────────────────────────────────────────────────
# Used at build time — must be the public URL users access the API from
NEXT_PUBLIC_API_URL=http://your-server-ip:3000
CORS_ORIGIN=http://your-server-ip:3001

# ── Cookies ───────────────────────────────────────────────────────────────────
# Set to true when serving over HTTPS
COOKIE_SECURE=false
# 'strict' for same-site deployments; 'none' on GCP (run.app api + frontend are
# different sites) — requires COOKIE_SECURE=true
COOKIE_SAMESITE=strict

# ── Tenant worker image ───────────────────────────────────────────────────────
TENANT_WORKER_IMAGE=ghcr.io/your-org/uassist/tenant-worker:latest
